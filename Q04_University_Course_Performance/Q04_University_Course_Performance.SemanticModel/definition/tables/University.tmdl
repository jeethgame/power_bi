table University
	lineageTag: 058e59cd-1937-4101-a672-197b2673be6a

	column StudentID
		dataType: int64
		lineageTag: 920232f0-2d91-4b81-ba17-acdeae06f190
		summarizeBy: none
		sourceColumn: StudentID

	column StudentName
		dataType: string
		lineageTag: 1c925805-8cd7-49fd-9565-0095eb387553
		summarizeBy: none
		sourceColumn: StudentName

	column CourseName
		dataType: string
		lineageTag: 921c8b72-6bff-4db5-a3db-2c5109a09083
		summarizeBy: none
		sourceColumn: CourseName

	column FacultyName
		dataType: string
		lineageTag: 683b1fec-1ae3-4cb0-b48b-0f067e190fc2
		summarizeBy: none
		sourceColumn: FacultyName

	column Marks
		dataType: double
		lineageTag: 8502eac7-a464-4abd-afc6-b7d970e4078b
		summarizeBy: average
		sourceColumn: Marks

	column Grade
		dataType: string
		lineageTag: 1e22f8bc-a12d-44fd-a8cf-e447dc099e81
		summarizeBy: none
		sourceColumn: Grade

	measure 'Avg Marks' = AVERAGE(University[Marks])
		lineageTag: 56ab74c1-2934-43e9-ac66-9eca529b26e8

	measure 'Total Students' = COUNTROWS(University)
		lineageTag: c882774a-f783-4dba-8361-72cb6ffd98fc

	measure 'Pass Count' = CALCULATE(COUNTROWS(University), University[Marks] >= 50)
		lineageTag: 6b3c7615-79bc-473b-8ad7-e845b1141fe5

	measure 'Pass %' = DIVIDE([Pass Count], [Total Students])
		lineageTag: 7b26afe6-1069-4bcd-9ffe-ba585f37fc64

	partition University = m
		mode: import
		source =
				let
					Source = Json.Document(Binary.Decompress(Binary.FromText("", BinaryEncoding.Base64), Compression.Deflate)),
					Table = Table.FromRows(Source, {"StudentID", "StudentName", "CourseName", "FacultyName", "Marks", "Grade"}),
					Typed = Table.TransformColumnTypes(Table, {{"StudentID", Int64.Type}, {"StudentName", type text}, {"CourseName", type text}, {"FacultyName", type text}, {"Marks", type number}, {"Grade", type text}}, "en-US")
				in
					Typed

	annotation PBI_ResultType = Table
